  "decisions": {
    "decisions": [
      {
        "id": "architecture-documentation-decision",
        "title": "Canon is the authority and site output is a projection",
        "status": "accepted",
        "type": "architecture",
        "rationale": "The Architecture Documentation domain accepts an explicit Canon document, then independently projects documentation HTML and Structurizr workspace/site artifacts. Generated output is disposable and does not replace the hand-authored Canon.",
        "targetIds": ["architecture-documentation", "canon-service", "static-site"],
        "referenceIds": ["architecture-cli-contract", "architecture-site-contract", "issue-43"],
        "supersedes": []
      },
      {
        "id": "authority-boundary-decision",
        "title": "Evaluation artifacts remain downstream of canonical authority",
        "status": "accepted",
        "type": "architecture",
        "rationale": "The implemented provider workflow writes observations, normalized facts, correlation, and Provider Matrix evaluation artifacts. The architecture-documentation CLI consumes an explicit Canon independently; Matrix artifacts are not used as Canon input.",
        "targetIds": ["canon-service", "correlation-engine", "provider-matrix", "provider-workflow"],
        "referenceIds": ["adr-024"],
        "supersedes": []
      },
      {
        "id": "cli-surface-decision",
        "title": "Architecture validation and rendering use the public CLI path",
        "status": "accepted",
        "type": "architecture",
        "rationale": "The root CLI routes explicit Architecture Canon validate and render commands to the production architecture adapter without changing runtime provider behavior.",
        "targetIds": ["architecture-command", "wabachi-cli"],
        "referenceIds": ["architecture-cli-contract"],
        "supersedes": []
      }
    ],
    "references": [
      {
        "id": "adr-024",
        "label": "ADR-024 authority boundaries",
        "uri": "docs/architecture/ADR-024-v2-authority-boundaries.md",
        "description": "Accepted repository architecture contract separating authority processing from evaluation projections."
      },
      {
